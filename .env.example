# EmailJS (service + template IDs are not secrets). Real values go in .env.local / the host's env settings, never in git.
EMAILJS_REMINDER_SERVICE_ID=service_bxqqzum
EMAILJS_REMINDER_PUBLIC_KEY=
EMAILJS_REMINDER_PRIVATE_KEY=          # SECRET: EmailJS account private key (server-side sends require it)

# Appointment reminders
EMAILJS_REMINDER_TEMPLATE_ID=template_haqxgwp
EMAILJS_REMINDER_TEST_RECIPIENT=guildifyprojects@gmail.com
EMAILJS_REMINDER_TEST_MODE=            # test mode is ON unless this is "off"

# Free-trial reminders
EMAILJS_TRIAL_TEMPLATE_ID=template_kcs6lzp
EMAILJS_TRIAL_TEST_RECIPIENT=guildifyprojects@gmail.com
EMAILJS_TRIAL_TEST_MODE=               # test mode is ON unless this is "off"
TRIAL_FOLLOWUP_DAYS=3                  # post-expiry follow-up; 0 disables
TRIAL_SUBSCRIPTION_URL=                # default: <APP_URL>/m/subscriptions
TRIAL_SUPPORT_EMAIL=                   # default: email in src/lib/config/clinicConfig.ts
APP_URL=

# Cron endpoint /api/cron/appointment-reminders (Vercel sends it as a Bearer token)
CRON_SECRET=                           # SECRET: any long random string
